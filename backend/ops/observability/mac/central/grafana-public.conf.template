map $http_upgrade $knot_grafana_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    server_name ${GRAFANA_DOMAIN};
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/knot-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://${GRAFANA_DOMAIN}$request_uri; }
}
server {
    listen 443 ssl;
    server_name ${GRAFANA_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${GRAFANA_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${GRAFANA_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_verify_client off;
    include /etc/nginx/snippets/knot-cloudflare-realip.conf;
    client_max_body_size 8m;
    location = /metrics { return 404; }
    location ^~ /debug/ { return 404; }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $knot_grafana_connection_upgrade;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
