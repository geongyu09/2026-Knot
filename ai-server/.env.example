# ai-server/에서 source 하세요. 실제 .env는 Git에서 제외합니다.
# EC2 백엔드와 같은 충분히 긴 임의 토큰을 설정하세요.
AI_APP_TOKEN=
AI_WORK_DIRECTORY="$PWD/runtime/jobs"
AI_PROFILE_FILE="$PWD/profile.json"
AI_RUNNER_DIRECTORY="$PWD/runner"
AI_ALLOWED_S3_HOSTS=example-bucket.s3.ap-northeast-2.amazonaws.com
AI_PORT=18765
AI_PYTHON=python3
AI_PNPM=pnpm
AI_FFMPEG=ffmpeg
